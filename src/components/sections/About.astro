---
import { Image } from 'astro:assets';
import { about } from '../../data/site';
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="section-head">
      <div class="section-title">
        <span class="label">#ABOUT</span>
        <h2 id="about-title">コミュニティについて</h2>
      </div>
    </div>

    <p class="lead">
      {
        about.lead.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>

    {about.stats.length > 0 && (
      <ul class="stats">
        {
          about.stats.map((stat) => (
            <li>
              {stat.label} {stat.value}
            </li>
          ))
        }
      </ul>
    )}

    <div class="organizers">
      <h3>運営メンバー</h3>
      <ul>
        {
          about.organizers.map((person) => (
            <li>
              {person.avatar ? (
                <Image
                  class="avatar"
                  src={person.avatar}
                  alt=""
                  width={38}
                  height={38}
                  densities={[1, 2, 3]}
                />
              ) : (
                <span class="avatar" aria-hidden="true" />
              )}
              <span>
                {person.role}：{person.name}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .lead {
    color: var(--muted);
    font-size: 13px;
    text-align: center;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-top: 16px;
    font: 12px var(--mono);
    color: var(--green-text);
  }

  .organizers {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .organizers h3 {
    font-size: 14px;
    font-weight: 400;
  }

  .organizers li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .avatar {
    width: 38px;
    height: 38px;
    flex: none;
    border: 1.5px solid var(--rule);
    object-fit: cover;
    background: repeating-linear-gradient(45deg, #eceae5 0 5px, #f7f6f3 5px 10px);
  }

  @media (max-width: 720px) {
    .stats {
      gap: 16px;
      font-size: 11px;
    }
  }
</style>
