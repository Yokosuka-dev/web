---
import { links, pastEvents } from '../../data/site';
---

{pastEvents.length > 0 && (
  <section class="section" id="events" aria-labelledby="events-title">
    <div class="wrap">
      <div class="section-head">
        <div class="section-title">
          <span class="label">#EVENTS</span>
          <h2 id="events-title">これまでのイベント</h2>
        </div>
        <a class="head-link" href={links.connpass}>connpassの一覧へ ↗</a>
      </div>

      <ul class="event-list">
        {
          pastEvents.map((event) => (
            <li>
              <span class="event-date">{event.date}</span>
              <span class="event-title">{event.title}</span>
              <span class="event-meta">{event.meta}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
)}

<style>
  .head-link {
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
  }

  .head-link:hover {
    color: var(--green-text);
  }

  .event-list {
    border: 1.5px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }

  .event-list li {
    display: grid;
    grid-template-columns: 86px 1fr 130px;
    gap: 12px;
    align-items: center;
    padding: 12px 14px;
    border-bottom: 1.5px dashed var(--rule);
  }

  .event-list li:last-child {
    border-bottom: 0;
  }

  .event-date {
    font: 12px var(--mono);
    color: var(--muted-warm);
  }

  .event-title {
    font-size: 13px;
  }

  .event-meta {
    font-size: 11px;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .event-list li {
      grid-template-columns: 1fr;
      gap: 3px;
      padding: 10px 12px;
    }
  }
</style>
