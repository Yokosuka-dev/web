{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yokosuka-dev-web",
  "compatibility_date": "2025-09-01",
  "routes": [
    { "pattern": "yokosuka.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
